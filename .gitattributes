# Normalize to LF in the repository; check out native line endings on Windows.
* text=auto

*.py text diff=python
*.md text
*.yml text
*.yaml text
*.cff text
*.toml text
*.in text
*.txt text

# PowerShell is happiest with CRLF on disk.
*.ps1 text eol=crlf

LICENSE text
CITATION.cff text

*.parquet binary
*.zip binary
*.xls binary
*.xlsx binary
*.pdf binary
